# Base URL of the deployed Friendzy backend (Render).
# VITE_API_URL may optionally include the '/api' path (e.g. https://friendzy-api.onrender.com/api);
# the frontend appends '/api' automatically if it is not present.
VITE_API_URL=https://friendzy-api.onrender.com

# Socket.IO endpoint for realtime chat. Falls back to VITE_API_URL (with '/api' stripped) if unset.
VITE_SOCKET_URL=https://friendzy-api.onrender.com
